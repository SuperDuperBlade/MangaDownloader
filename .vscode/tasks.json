{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "/usr/bin/g++",
      "type": "shell",
      "args": [
        "-std=c++20",       // Use C++20 standard
        "-o", "Main",       // Output executable name
        "Main.cpp", "MangaDex.h", "MangaDex.cpp", // Source files
        "-I", "/libs",      // Include paths (if any additional)
        "-I", "/util",
        "-lssl", "-lcrypto", "-lsimdjson", "-lzip" // Link libraries
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$gcc"
    }
  ]
}
